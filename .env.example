# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# JANGAN PERNAH commit file .env yang berisi password asli ke Git.

# Konfigurasi PostgreSQL (host VPS, localhost-only dari Fase 2)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=inventori_gudang_db
DB_USER=inventori_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB_SEBENARNYA

# Konfigurasi aplikasi web (bind 127.0.0.1 di produksi agar tidak terekspos publik)
APP_BIND=127.0.0.1
APP_PORT=8000
APP_VERSION=v1.0.0
SECRET_KEY=ganti-dengan-string-acak-yang-panjang
